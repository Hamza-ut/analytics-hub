ENV=dev
DEBUG=True

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

POSTGRES_DB=analytics_hub_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

DB_NAME=analytics_hub_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-superuser-password

CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

USE_HPC=False
HPC_HOST=rocket.hpc.ut.ee
HPC_USERNAME=your-hpc-username
HPC_PRIVATE_KEY_PATH=~/.ssh/your-private-key
HPC_INPUT_DATA_BASE=/gpfs/helios/home/your-username/projects/analytics-hub/input_data/
HPC_PROJECT_BASE=/gpfs/helios/home/your-username/projects/analytics-hub
HPC_DRC_TIMEPOINT_SBATCH=/gpfs/helios/home/your-username/projects/analytics-hub/jobs/submit_drc.sh
